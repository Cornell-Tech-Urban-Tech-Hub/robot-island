---
import Layout from "../layouts/Layout.astro";
import RatingDisplay from "../components/RatingDisplay.astro";
import Footer from "../components/Footer.astro";
import { getCollection } from "astro:content";

const allCaseStudies = await getCollection("case-studies");

// Group by type
const passengerStudies = allCaseStudies.filter(s => s.data.type === "passenger");
const freightStudies = allCaseStudies.filter(s => s.data.type === "freight");
const serviceStudies = allCaseStudies.filter(s => s.data.type === "service");

// Fetch ratings for all case studies
const slugs = allCaseStudies.map(s => s.slug);
let ratingsData: Record<string, any> = {};
try {
	const ratingsResponse = await fetch(`${Astro.url.origin}/api/ratings`, {
		method: 'POST',
		headers: { 'Content-Type': 'application/json' },
		body: JSON.stringify({ slugs })
	});
	const result = await ratingsResponse.json();
	if (result.success && result.data) {
		ratingsData = result.data;
	}
} catch (error) {
	console.error('Error fetching ratings:', error);
}

const geojsonUrls = import.meta.glob(
	"/src/content/case-studies/**/*.geojson",
	{ query: "?url", import: "default", eager: true },
) as Record<string, string>;
const mediaUrls = import.meta.glob(
	"/src/content/case-studies/**/*.{jpg,jpeg,png,svg,webp,gif,mp4}",
	{ query: "?url", import: "default", eager: true },
) as Record<string, string>;

function assetUrl(slug: string, file: string | undefined, map: Record<string, string>) {
	if (!file) return "";
	if (file.startsWith("http")) return file;
	return map[`/src/content/case-studies/${slug}/${file}`] ?? "";
}

function thumbnailUrl(slug: string, file: string | undefined, map: Record<string, string>, size: 'thumb' | 'medium' = 'thumb') {
	if (!file) return "";
	if (file.startsWith("http")) return file;

	// Get base name without extension
	const lastDot = file.lastIndexOf('.');
	const baseName = lastDot > -1 ? file.substring(0, lastDot) : file;
	const ext = lastDot > -1 ? file.substring(lastDot) : '';

	// Try thumbnail first (they're always .jpg)
	const thumbFile = `${baseName}-${size}.jpg`;
	const thumbUrl = map[`/src/content/case-studies/${slug}/${thumbFile}`];

	// Fallback to original if thumbnail doesn't exist
	return thumbUrl || assetUrl(slug, file, map);
}
---

<Layout title="Robot Island" hideNav={true}>
	<main class="atlas-home">
		<div class="content-side">
			<section class="hero">
				<h1><span class="accent">Robot</span> Island</h1>
				<p class="subtitle">Autonomous vehicle futures on Roosevelt Island</p>
				<p class="intro">Explore speculative case studies designed by Cornell Tech students imagining how autonomous vehicles could transform Roosevelt Island — from passenger shuttles to freight delivery to civic services. Each study is grounded in a real location on the island. <a href="/about">Learn more &rarr;</a></p>
			</section>

			<section class="case-studies">
				{passengerStudies.length > 0 && (
					<div class="type-section">
						<h2 class="type-heading">Passenger</h2>
						<div class="card-grid">
							{passengerStudies.map((study) => {
								const featuredMedia = study.data.media?.find(m => m.featured);
								const cardImage = thumbnailUrl(study.slug, featuredMedia?.file, mediaUrls, 'thumb');
								const geojsonUrl = assetUrl(study.slug, study.data.geojson, geojsonUrls);
								return (
									<a
										href={`/case-studies/${study.slug}`}
										class="card-link"
										data-geojson={geojsonUrl}
										data-slug={study.slug}
										data-concept={study.data.concept}
										data-image={cardImage}
									>
										<article class="case-card">
											<div
												class="card-image"
												style={cardImage ? `background-image: url('${cardImage}')` : 'background-color: #334155'}
											/>
											<div class="card-content">
												<h3>{study.data.concept}</h3>
												{study.data.author && <p class="card-author">{study.data.author}</p>}
												<RatingDisplay
													slug={study.slug}
													rating={ratingsData[study.slug]?.summary}
												/>
											</div>
										</article>
									</a>
								);
							})}
						</div>
					</div>
				)}

				{freightStudies.length > 0 && (
					<div class="type-section">
						<h2 class="type-heading">Freight</h2>
						<div class="card-grid">
							{freightStudies.map((study) => {
								const featuredMedia = study.data.media?.find(m => m.featured);
								const cardImage = thumbnailUrl(study.slug, featuredMedia?.file, mediaUrls, 'thumb');
								const geojsonUrl = assetUrl(study.slug, study.data.geojson, geojsonUrls);
								return (
									<a
										href={`/case-studies/${study.slug}`}
										class="card-link"
										data-geojson={geojsonUrl}
										data-slug={study.slug}
										data-concept={study.data.concept}
										data-image={cardImage}
									>
										<article class="case-card">
											<div
												class="card-image"
												style={cardImage ? `background-image: url('${cardImage}')` : 'background-color: #334155'}
											/>
											<div class="card-content">
												<h3>{study.data.concept}</h3>
												{study.data.author && <p class="card-author">{study.data.author}</p>}
												<RatingDisplay
													slug={study.slug}
													rating={ratingsData[study.slug]?.summary}
												/>
											</div>
										</article>
									</a>
								);
							})}
						</div>
					</div>
				)}

				{serviceStudies.length > 0 && (
					<div class="type-section">
						<h2 class="type-heading">Service</h2>
						<div class="card-grid">
							{serviceStudies.map((study) => {
								const featuredMedia = study.data.media?.find(m => m.featured);
								const cardImage = thumbnailUrl(study.slug, featuredMedia?.file, mediaUrls, 'thumb');
								const geojsonUrl = assetUrl(study.slug, study.data.geojson, geojsonUrls);
								return (
									<a
										href={`/case-studies/${study.slug}`}
										class="card-link"
										data-geojson={geojsonUrl}
										data-slug={study.slug}
										data-concept={study.data.concept}
										data-image={cardImage}
									>
										<article class="case-card">
											<div
												class="card-image"
												style={cardImage ? `background-image: url('${cardImage}')` : 'background-color: #334155'}
											/>
											<div class="card-content">
												<h3>{study.data.concept}</h3>
												{study.data.author && <p class="card-author">{study.data.author}</p>}
												<RatingDisplay
													slug={study.slug}
													rating={ratingsData[study.slug]?.summary}
												/>
											</div>
										</article>
									</a>
								);
							})}
						</div>
					</div>
				)}
			</section>

			<Footer />
		</div>
		<div class="map-side">
			<div class="map-container" id="map"></div>
		</div>
	</main>
</Layout>

<style>
	/* Mapbox popup override */
	:global(.mapboxgl-popup-content) {
		padding: 0 !important;
		border-radius: 4px !important;
		overflow: hidden;
	}

	/* Split Layout */
	.atlas-home {
		display: flex;
		height: 100vh;
		overflow: hidden;
	}

	.content-side {
		width: 66.666%;
		overflow-y: auto;
		padding: 2rem;
		background: #2A2D3E;
	}

	.map-side {
		width: 33.333%;
		position: relative;
	}

	.map-side .map-container {
		width: 100%;
		height: 100%;
		position: absolute;
		top: 0;
		left: 0;
	}

	/* Hero Section */
	.hero {
		margin-bottom: 2rem;
	}

	.hero h1 {
		font-family: var(--font-sans);
		font-size: 3.5rem;
		font-weight: 700;
		color: #fff;
		margin-bottom: 1.5rem;
	}

	.hero h1 .accent {
		color: var(--color-accent);
	}

	.hero .subtitle {
		font-family: var(--font-serif);
		font-size: 1.5rem;
		color: rgba(255, 255, 255, 0.85);
		line-height: 1.6;
		margin-bottom: 1.5rem;
	}

	.hero .intro {
		font-family: var(--font-serif);
		font-size: 1.1rem;
		color: rgba(255, 255, 255, 0.7);
		max-width: none;
		line-height: 1.6;
		margin-top: 1.5rem;
	}

	.hero .intro a {
		color: var(--color-accent);
		text-decoration: none;
	}

	.hero .intro a:hover {
		text-decoration: underline;
	}

	/* Type Sections */
	.case-studies {
		margin-bottom: 4rem;
	}

	.type-section {
		margin-bottom: 3rem;
	}

	.type-section:last-child {
		margin-bottom: 0;
	}

	.type-heading {
		font-family: var(--font-sans);
		font-size: 1.75rem;
		font-weight: 700;
		color: rgba(255, 255, 255, 0.95);
		margin-bottom: 1.25rem;
		text-transform: capitalize;
	}

	/* Card Grid */
	.card-grid {
		display: grid;
		grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
		gap: 1.25rem;
	}

	/* Card Link */
	a.card-link {
		text-decoration: none;
		color: inherit;
		display: flex;
	}

	a.card-link:hover {
		text-decoration: none;
	}

	/* Card Design */
	.case-card {
		background: #fff;
		border-radius: 6px;
		overflow: hidden;
		transition: transform 0.25s ease, box-shadow 0.25s ease;
		display: flex;
		flex-direction: column;
		width: 100%;
	}

	a.card-link:hover .case-card {
		transform: translateY(-4px);
		box-shadow: 0 8px 24px rgba(0, 0, 0, 0.3);
	}

	.card-image {
		height: 140px;
		background-size: cover;
		background-position: center;
		position: relative;
	}

	.card-content {
		padding: 1rem;
		flex: 1;
		display: flex;
		flex-direction: column;
	}

	.card-content h3 {
		font-family: var(--font-sans);
		font-size: 1rem;
		font-weight: 700;
		color: var(--color-text-primary);
		margin-bottom: 0.5rem;
		line-height: 1.3;
	}

	.card-author {
		font-family: var(--font-sans);
		font-size: 0.875rem;
		color: rgba(0, 0, 0, 0.6);
		margin: 0;
	}

	/* Responsive */
	@media (max-width: 768px) {
		.atlas-home {
			flex-direction: column;
			height: auto;
			overflow: visible;
		}

		.content-side {
			width: 100%;
			overflow-y: visible;
		}

		.map-side {
			width: 100%;
			height: 400px;
			position: relative;
			order: -1;
		}

		.hero h1 {
			font-size: 2.5rem;
		}

		.hero .subtitle {
			font-size: 1.25rem;
		}

		.hero .intro {
			font-size: 1rem;
		}

		.card-grid {
			grid-template-columns: 1fr;
			gap: 1.5rem;
		}
	}

	/* Hide map on mobile portrait */
	@media (max-width: 768px) and (orientation: portrait) {
		.map-side {
			display: none;
		}
	}

	@media (max-width: 480px) {
		.hero h1 {
			font-size: 2rem;
		}
	}
</style>

<script>
	import mapboxgl from "mapbox-gl";

	const token = import.meta.env.PUBLIC_MAPBOX_TOKEN;
	if (!token) {
		console.error("PUBLIC_MAPBOX_TOKEN is missing from your .env file!");
	}
	mapboxgl.accessToken = token;

	function initMap() {
		const mapContainer = document.getElementById("map");
		if (!mapContainer) return;

		const map = new mapboxgl.Map({
			container: "map",
			style: "mapbox://styles/mapbox/light-v11",
			center: [-73.950, 40.762],
			zoom: 14,
			bearing: 28,
		});

		(window as any).atlasMap = map;

		// Single reusable popup for hover
		const hoverPopup = new mapboxgl.Popup({
			closeButton: false,
			closeOnClick: false,
		});

		map.on("load", async () => {
			// Build slug-to-geojson mapping from card elements
			const cards = document.querySelectorAll("a.card-link");
			const slugToGeojson: Record<string, string> = {};
			const slugToCard: Record<string, { concept: string; image: string }> = {};

			cards.forEach((card) => {
				const el = card as HTMLElement;
				const slug = el.dataset.slug;
				const geojsonUrl = el.dataset.geojson;
				if (slug && geojsonUrl) {
					slugToGeojson[geojsonUrl] = slug;
				}
				if (slug) {
					slugToCard[slug] = {
						concept: el.dataset.concept || slug,
						image: el.dataset.image || "",
					};
				}
			});

			// Fetch all geojson files and merge into one FeatureCollection
			const geojsonPaths = Object.keys(slugToGeojson);
			if (geojsonPaths.length === 0) return;

			try {
				const responses = await Promise.all(
					geojsonPaths.map((url) => fetch(url)),
				);
				const dataArrays = await Promise.all(
					responses.map((res) => res.json()),
				);

				const allFeatures: any[] = [];

				dataArrays.forEach((data, i) => {
					const geojsonPath = geojsonPaths[i];
					const slug = slugToGeojson[geojsonPath];

					if (data && data.features) {
						data.features.forEach((feature: any) => {
							const enrichedFeature = {
								...feature,
								properties: {
									...feature.properties,
									slug: slug,
									name: feature.properties?.name || slug,
								},
							};
							allFeatures.push(enrichedFeature);
						});
					}
				});

				const mergedCollection = {
					type: "FeatureCollection" as const,
					features: allFeatures,
				};

				// Add source
				map.addSource("all-boundaries", {
					type: "geojson",
					data: mergedCollection,
				});

				// Base fill layer
				map.addLayer({
					id: "boundaries-fill",
					type: "fill",
					source: "all-boundaries",
					paint: {
						"fill-color": "#0066FF",
						"fill-opacity": 0.05,
					},
				});

				// Base line layer
				map.addLayer({
					id: "boundaries-line",
					type: "line",
					source: "all-boundaries",
					paint: {
						"line-color": "#0066FF",
						"line-width": 0.5,
						"line-opacity": 0.3,
					},
				});

				// Hover fill layer (initially matches nothing)
				map.addLayer({
					id: "boundaries-fill-hover",
					type: "fill",
					source: "all-boundaries",
					paint: {
						"fill-color": "#0066FF",
						"fill-opacity": 0.4,
					},
					filter: ["==", ["get", "slug"], ""],
				});

				// Hover line layer (initially matches nothing)
				map.addLayer({
					id: "boundaries-line-hover",
					type: "line",
					source: "all-boundaries",
					paint: {
						"line-color": "#0066FF",
						"line-width": 3,
					},
					filter: ["==", ["get", "slug"], ""],
				});

				// Fit bounds to all features
				if (allFeatures.length > 0) {
					const bounds = new mapboxgl.LngLatBounds();

					const extractCoords = (coords: any) => {
						if (
							typeof coords[0] === "number" &&
							typeof coords[1] === "number"
						) {
							bounds.extend([coords[0], coords[1]]);
						} else {
							coords.forEach(extractCoords);
						}
					};

					allFeatures.forEach((feature: any) => {
						if (
							feature.geometry &&
							feature.geometry.coordinates
						) {
							extractCoords(feature.geometry.coordinates);
						}
					});

					// fitBounds uses an axis-aligned bbox which wastes space
					// when the map is rotated. Fit first, then zoom in to compensate.
					map.fitBounds(bounds, {
						padding: 0,
						bearing: 28,
					});
					map.once("moveend", () => {
						map.zoomTo(map.getZoom() + 0.5, { duration: 0 });
					});

					// Re-fit on window resize so map adapts to container size changes
					window.addEventListener("resize", () => {
						map.resize();
						map.fitBounds(bounds, {
							padding: 0,
							bearing: 28,
						});
						map.once("moveend", () => {
							map.zoomTo(map.getZoom() + 0.5, { duration: 0 });
						});
					});
				}

				// Hover behavior
				map.on("mousemove", "boundaries-fill", (e: any) => {
					if (e.features && e.features.length > 0) {
						const feature = e.features[0];
						const slug = feature.properties.slug;
						const name = feature.properties.name;

						// Update hover layer filters
						map.setFilter("boundaries-fill-hover", [
							"==",
							["get", "slug"],
							slug,
						]);
						map.setFilter("boundaries-line-hover", [
							"==",
							["get", "slug"],
							slug,
						]);

						// Change cursor
						map.getCanvas().style.cursor = "pointer";

						// Show popup with image, concept, and link
						const cardData = slugToCard[slug];
						const imgHtml = cardData?.image
							? `<img src="${cardData.image}" style="width:100%;height:80px;object-fit:cover;border-radius:3px 3px 0 0;display:block;" />`
							: "";
						hoverPopup
							.setLngLat(e.lngLat)
							.setHTML(
								`<div style="width:160px;font-family:'Space Grotesk',sans-serif;">`
								+ imgHtml
								+ `<div style="padding:6px 8px;">`
								+ `<strong style="font-size:0.8em;line-height:1.3;display:block;">${cardData?.concept || name}</strong>`
								+ `<span style="font-size:0.7em;color:#888;">${name}</span>`
								+ `</div></div>`
							)
							.addTo(map);
					}
				});

				map.on("mouseleave", "boundaries-fill", () => {
					// Reset hover filters
					map.setFilter("boundaries-fill-hover", [
						"==",
						["get", "slug"],
						"",
					]);
					map.setFilter("boundaries-line-hover", [
						"==",
						["get", "slug"],
						"",
					]);

					// Reset cursor
					map.getCanvas().style.cursor = "";

					// Remove popup
					hoverPopup.remove();
				});

				// Click behavior
				map.on("click", "boundaries-fill", (e: any) => {
					if (e.features && e.features.length > 0) {
						const feature = e.features[0];
						const slug = feature.properties.slug;
						window.location.href = `/case-studies/${slug}`;
					}
				});
			// Card hover → highlight map zone
				cards.forEach((card) => {
					const el = card as HTMLElement;
					const slug = el.dataset.slug;
					if (!slug) return;

					el.addEventListener("mouseenter", () => {
						map.setFilter("boundaries-fill-hover", [
							"==",
							["get", "slug"],
							slug,
						]);
						map.setFilter("boundaries-line-hover", [
							"==",
							["get", "slug"],
							slug,
						]);
					});

					el.addEventListener("mouseleave", () => {
						map.setFilter("boundaries-fill-hover", [
							"==",
							["get", "slug"],
							"",
						]);
						map.setFilter("boundaries-line-hover", [
							"==",
							["get", "slug"],
							"",
						]);
					});
				});
			} catch (err) {
				console.error("Error loading GeoJSON data:", err);
			}
		});
	}

	// Initialize on page load
	document.addEventListener("astro:page-load", initMap);

	if (
		document.readyState === "complete" ||
		document.readyState === "interactive"
	) {
		initMap();
	} else {
		document.addEventListener("DOMContentLoaded", initMap);
	}
</script>
